# Local environment: never in this PUBLIC repo. `.env.local` holds the release gate's two public client
# identifiers for builds on this machine (docusaurus.config.ts loads it; the build refuses without them).
.env
.env.*

# Dependencies
node_modules/
.yarn/cache
.yarn/install-state.gz
.pnp.*

# Build outputs
.playwright-cli/
.docusaurus/
build/
dist/
*.tsbuildinfo

# Generated files
.cache-loader

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env / secrets — THIS REPO IS PUBLIC. Only .env.example may ever be tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
key.properties
keystore.properties
*service-account*.json
*credential*
.npmrc

# Project-record / private notes
project-record-ignore/
*.ignore.*

# Lock-files from unwanted package managers (yarn-only repo)
package-lock.json
pnpm-lock.yaml
