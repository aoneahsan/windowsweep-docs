# windowsweep-docs — environment contract
#
# 🔴 THIS REPO IS PUBLIC. Never commit a real value here.
#    Real values live in ~/.secrets/<service>/<name> and are supplied to the
#    local manual build without committing them.
#
# An unset [OPTIONAL] key means that provider is skipped entirely — the docs
# build must never require a secret to succeed. The four [REQUIRED*] keys are
# public client identifiers, not secrets: `yarn start` runs without them, and
# docusaurus.config.ts refuses a production build while any of them is unset.

# [OPTIONAL] Google Analytics 4 measurement ID. Unset = no analytics script.
GA_MEASUREMENT_ID=

# [OPTIONAL] Microsoft Clarity project ID. Unset = no session replay.
CLARITY_PROJECT_ID=

# [OPTIONAL] Amplitude API key. Unset = no product analytics.
AMPLITUDE_API_KEY=

# [OPTIONAL] Sentry DSN for build/runtime error reporting. Unset = no Sentry.
SENTRY_DSN=

# [REQUIRED*] Public Supabase project URL for the docs release notice and block.
DOCS_SUPABASE_URL=

# [REQUIRED*] Public publishable key for reading the release view and broadcast.
DOCS_SUPABASE_PUBLISHABLE_KEY=

# [OPTIONAL] production (default) or test for an isolated release-gate verification build.
DOCS_RELEASE_CHANNEL=production

# [REQUIRED*] The FilesHub marketing list id the footer's release-notes signup posts to (the website's
# VITE_NEWSLETTER_LIST_ID). Without it and the key below, the footer has no signup row.
DOCS_NEWSLETTER_LIST_ID=

# [REQUIRED*] The subscribe-only, origin-restricted FilesHub browser key, a public client identifier (the
# website's VITE_FILESHUB_NEWSLETTER_KEY).
DOCS_FILESHUB_NEWSLETTER_KEY=

# [OPTIONAL] The Cloudflare Turnstile site key FilesHub checks a signup against (public).
DOCS_TURNSTILE_SITE_KEY=
