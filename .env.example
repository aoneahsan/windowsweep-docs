# windowsweep-docs — environment contract
#
# 🔴 THIS REPO IS PUBLIC. Never commit a real value here.
#    Real values live in ~/.secrets/<service>/<name> and are supplied to the
#    local manual build without committing them.
#
# Every key below is OPTIONAL. An unset key means that provider is skipped
# entirely — the docs build must never require a secret to succeed.

# [OPTIONAL] Google Analytics 4 measurement ID. Unset = no analytics script.
GA_MEASUREMENT_ID=

# [OPTIONAL] Microsoft Clarity project ID. Unset = no session replay.
CLARITY_PROJECT_ID=

# [OPTIONAL] Amplitude API key. Unset = no product analytics.
AMPLITUDE_API_KEY=

# [OPTIONAL] Sentry DSN for build/runtime error reporting. Unset = no Sentry.
SENTRY_DSN=

# [OPTIONAL] Public Supabase project URL for the docs release notice and block.
DOCS_SUPABASE_URL=

# [OPTIONAL] Public publishable key for reading the release view and broadcast.
DOCS_SUPABASE_PUBLISHABLE_KEY=

# [OPTIONAL] production (default) or test for an isolated release-gate verification build.
DOCS_RELEASE_CHANNEL=production
