{
  "name": "windowsweep-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public documentation site for windowsweep, a Windows PowerShell CLI that reclaims disk space by deleting regenerable caches behind one deletion chokepoint, an idle gate and a real dry-run. Built with Docusaurus, deployed to GitHub Pages.",
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "homepage": "https://windowsweep-docs.aoneahsan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/windowsweep-docs.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/windowsweep/issues",
    "email": "aoneahsan@gmail.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 5972 --host 0.0.0.0",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port 5973",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "typecheck:clean": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "yarn typecheck && yarn build",
    "deps:outdated": "npx -y npm-check-updates",
    "deps:update": "npx -y npm-check-updates -u --reject typescript && yarn install",
    "postinstall": "husky"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "packageManager": "yarn@4.17.1"
}
